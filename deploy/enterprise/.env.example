# NIMBORA Enterprise — configuration. install.sh copies this to .env and fills
# every secret with a random value; edit the "À RENSEIGNER" lines.

# --- À RENSEIGNER --------------------------------------------------------------
PUBLIC_HOST=callcenter.example.com          # domain pointing to this VPS (DNS A record)
PUBLIC_BASE_URL=https://callcenter.example.com
PUBLIC_IP=203.0.113.10                      # public IPv4 of the VPS (auto-detected)
ACME_EMAIL=admin@example.com                # Let's Encrypt notifications
SAAS_PLATFORM_NAME=NIMBORA

# --- Abonnements ---------------------------------------------------------------
SAAS_DEFAULT_PLAN=starter
SAAS_TRIAL_DAYS=14
SAAS_GRACE_DAYS=3
ENABLE_SIGNUP=true
# Paiement en ligne (optionnel). Sans clé, le super-admin attribue les plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA locale -----------------------------------------------------------------
# cpu = serveur sans GPU, gpu = serveur NVIDIA (pilotes + nvidia-container-toolkit)
COMPOSE_PROFILES=cpu
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
LOCAL_DEFAULT_LANGUAGE=fr
OLLAMA_NUM_PARALLEL=4

# --- Secrets (générés par install.sh — ne pas partager) -------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=nimbora
MINIO_ROOT_PASSWORD=
OSS_JWT_SECRET=
TURN_SECRET=
ASTERISK_ARI_PASSWORD=
TELEPHONY_WS_TOKEN_SECRET=
TELEPHONY_WS_TOKEN_ENFORCE=true

FASTAPI_WORKERS=2
