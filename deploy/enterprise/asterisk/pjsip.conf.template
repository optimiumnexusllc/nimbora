; NIMBORA Enterprise — PJSIP base configuration (rendered by install.sh).
; Tenant agents are generated by the platform into nimbora/pjsip_nimbora_agents.conf.

[global]
type=global
user_agent=NIMBORA-Enterprise
endpoint_identifier_order=ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=__PUBLIC_IP__
external_signaling_address=__PUBLIC_IP__
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=__PUBLIC_IP__
external_signaling_address=__PUBLIC_IP__
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

; Browser softphones reach Asterisk's HTTP /ws through Caddy (TLS ends there).
[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0

; ---------------------------------------------------------------------------
; SIP trunks of your carrier(s) go in pjsip_trunks.conf (see README).
; ---------------------------------------------------------------------------
#tryinclude pjsip_trunks.conf

#tryinclude nimbora/pjsip_nimbora_agents.conf
