# NIMBORA lab — parameters, saved by install.sh in /etc/nimbora-lab/lab.env.
# Every value can also be given as a flag (see ./install.sh --help). Values from
# the flags win over this file, which wins over the defaults.

# Public names (already pointing at this server)
APP_DOMAIN=app.example.com
PBX_DOMAIN=pbx.example.com

# Brand and first customer company on the PBX
BRAND=NIMBORA
COMPANY="Entreprise test"

# Public interface and IPv4 of the server (detected from the default route)
#PUBLIC_IF=eth0
#PUBLIC_IP=203.0.113.10

# Incus: bridge, address of the host on it (/24), container address and limits
INCUS_BRIDGE=incusbr0
BRIDGE_CIDR=10.250.0.1/24
PBX_IP=10.250.0.10
PBX_NAME=nimbora-pbx
PBX_MEMORY=4GiB
PBX_CPU=2

# Existing Traefik (Coolify defaults)
TRAEFIK_DYNAMIC_DIR=/data/coolify/proxy/dynamic
TRAEFIK_NETWORK=coolify

# NIMBORA stack
DEPLOY_DIR=/opt/nimbora-lab
NIMBORA_BRIDGE=br-nimboralab
NIMBORA_SUBNET=10.250.1.0/24
FASTAPI_WORKERS=2
# Extra KEY=value lines merged into the stack's .env at every run (SMTP, options…),
# root-only file. Default: /etc/nimbora-lab/secrets.env, used as soon as it exists.
# AI provider keys are NOT environment variables: they are entered in the console
# (Inference providers → Add connection) and stored per organisation.
#SECRETS_FILE=/etc/nimbora-lab/secrets.env

# Telephony exposure
RTP_RANGE=10000-20000
# 1 = redirect SIP 5060/5061 from the Internet to the PBX (needs an operator)
SIP_PUBLIC=0
# 1 = install and enable UFW with the port list below (hosts without an
# upstream firewall); 0 = the hosting provider's firewall does the filtering
UFW=0
